#!/bin/sh
# GIONG VN — CỔNG COMMIT FILE DÙNG CHUNG (GĐ 495, 21/10/2026)
# Cài bằng: python scripts/agents/install-hooks.py   (áp cho MỌI worktree của repo)
#
# 2 tai nạn thật đã xảy ra (GĐ 470 · GĐ 494): phiên này commit NUỐT bài dở của
# phiên khác, và phiên khác commit bản LỆCH làm XOÁ bài của phiên này.
# Hook chặn đúng 2 đường đó:
#   (1) APPEND-ONLY: cấm mọi commit XOÁ dòng entry (`### GĐ/C.x`) hoặc dòng bảng
#       registry (`| GĐ/C.x`) — trừ khi cố ý (commit message có [shared-approved]).
#   (2) CỔNG AN TOÀN: muốn sửa file dùng chung phải commit qua
#       `python scripts/agents/shared-doc.py commit --entry "GĐ xxx" -m "..."`
#       (script ghép CHỈ entry của mình lên bản HEAD, không nuốt bài phiên khác).
#       Chắc chắn 100% kiểm soát nội dung → thêm cờ --no-verify.
# Mọi lần commit file dùng chung đều được SNAPSHOT tự động (bảo hiểm bài dở).

FILES="AGENTS.md AGENT_REGISTRY.md AGENTS_ARCHIVE.md"
GITDIR=$(git rev-parse --git-dir 2>/dev/null) || exit 0
COMMONDIR=$(git rev-parse --git-common-dir 2>/dev/null) || COMMONDIR="$GITDIR"

staged=""
for f in $FILES; do
    if git diff --cached --name-only -- "$f" 2>/dev/null | grep -q .; then
        staged="$staged $f"
    fi
done
[ -z "$staged" ] && exit 0

# --- SNAPSHOT tự động (giữ 50 bản gần nhất) ---
SNAP="$COMMONDIR/giong-shared-snapshots"
mkdir -p "$SNAP" 2>/dev/null
TS=$(date +%Y%m%d_%H%M%S)
for f in $staged; do
    [ -f "$f" ] && cp -f "$f" "$SNAP/$(echo "$f" | tr '/' '_').$TS" 2>/dev/null
done
ls -1t "$SNAP" 2>/dev/null | tail -n +51 | while read -r old; do rm -f "$SNAP/$old"; done

# --- (1) APPEND-ONLY GUARD — LUÔN chạy (kể cả khi qua script cổng: đây là lớp 2) ---
if grep -q "\[shared-approved\]" "$GITDIR/COMMIT_EDITMSG" 2>/dev/null; then
    exit 0
fi
DEL=$(git diff --cached -U0 -- $staged 2>/dev/null \
      | grep -E '^-' | grep -vE '^---' \
      | grep -cE '^-###[[:space:]]+(GĐ|C\.)|^-\|+[[:space:]]*(GĐ|C\.)')
if [ "$DEL" -gt 0 ]; then
    echo ""
    echo "⛔ CỔNG FILE DÙNG CHUNG — commit này XOÁ $DEL dòng ENTRY/REGISTRY (GĐ/C.x)."
    echo "   Nghĩa là bản trong máy em đang LỆCH — thiếu bài của phiên khác. Nếu commit,"
    echo "   bài của phiên đó MẤT trên lịch sử chung."
    echo "   → Xem 2 đầu:      python scripts/agents/shared-doc.py check"
    echo "   → Xem entry mới:  python scripts/agents/shared-doc.py list"
    echo "   → Commit an toàn: python scripts/agents/shared-doc.py commit --entry \"GĐ xxx\" -m \"...\""
    echo "   → Cố ý (tách archive/dọn dẹp): thêm [shared-approved] vào commit message."
    echo ""
    exit 1
fi

# --- (2) GATE: buộc commit qua script cổng ---
if [ "$GIONG_SHARED_OK" = "1" ]; then exit 0; fi
echo "⛔ CỔNG FILE DÙNG CHUNG (GĐ 495) — commit này sửa:$staged"
echo "   Để KHÔNG nuốt bài dở của phiên song song, hãy commit qua cổng an toàn:"
echo "     python scripts/agents/shared-doc.py commit --entry \"GĐ xxx\" -m \"docs(...): ...\""
echo "        (hoặc --all-new nếu chỉ có entry của mình)"
echo "   Cổng sẽ ghép CHỈ entry của mình lên bản HEAD và giữ nguyên bản dở phiên khác."
echo "   Chắc chắn 100% mình kiểm soát nội dung file → dùng: git commit --no-verify"
echo ""
exit 1
